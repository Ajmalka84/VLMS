# ==============================================================================
#                 VLMS PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.production on your production VPS server:
#   cp .env.production.example .env.production
#
# IMPORTANT: Generate strong random secrets before starting in production!
#   Generate random password: openssl rand -hex 16
#   Generate JWT secret:      openssl rand -hex 32
# ==============================================================================

# Node Environment
NODE_ENV=production

# PostgreSQL Database Configuration (Internal Docker service)
POSTGRES_DB=vlms_prod
POSTGRES_USER=vlms_admin
POSTGRES_PASSWORD=change_this_to_a_strong_random_db_password
POSTGRES_PORT=5432

# Backend Application Configuration
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=80

# Production URLs & Domains
# Replace "yourdomain.com" with your actual registered domain (e.g., vlms.in)
FRONTEND_ORIGIN=https://yourdomain.com,http://yourdomain.com
VITE_BACKEND_URL=https://yourdomain.com

# Internal Database Connection String
# Must match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB above
DATABASE_URL=postgresql://vlms_admin:change_this_to_a_strong_random_db_password@postgres:5432/vlms_prod?schema=public

# Authentication & Security Secrets
JWT_SECRET=change_this_to_a_64_character_random_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Super Admin Initial Production Credentials
SUPER_ADMIN_MOBILE=ajmalka84@gmail.com
SUPER_ADMIN_PASSWORD=SetYourProductionMasterPasswordHere
